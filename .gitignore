# Agent-local state can contain credentials; track only the shared Spec Kit skills.
.agents/*
!.agents/skills/
!.agents/skills/**

# Common generated output not owned by nested ignore files.
.DS_Store
.pnpm-store/
.local/
**/.local/
**/bin/
**/obj/

# Local configuration and database artifacts. Commit examples only.
.env
.env.*
!.env.example
!**/.env.example
*.dump
*.sql.gz

# Sandbox and package caches
Library/
scratch/
**/.nuget/
