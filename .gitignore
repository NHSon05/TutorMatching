# Hidden configuration and tooling directories
.agents/
.config/
.specify/

# Common generated output not owned by nested ignore files.
.DS_Store
.pnpm-store/
.local/
**/.local/
**/bin/
**/obj/

# Local configuration and database artifacts. Commit examples only.
.env
.env.*
!.env.example
!**/.env.example
*.dump
*.sql.gz

# Sandbox and package caches
Library/
scratch/
**/.nuget/

# Graphify indexes, caches, and visualizations are rebuilt locally.
graphify-out/

# Runtime user uploads (not source assets).
/backend/src/TutorMatching.Api/wwwroot/uploads/

# Generated test results and local logs.
**/TestResults/
**/coverage/
**/test-results/
**/playwright-report/
**/blob-report/
*.log

# Per-machine agent settings and temporary worktrees.
.claude/settings.local.json
.claude/worktrees/
