  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "accessToken"
      }
    },
    "schemas": {
      "Schedule": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dayOfWeek": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "startTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "endTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          }
        },
        "required": [
          "dayOfWeek",
          "startTime",
          "endTime"
        ]
      },
      "Terms": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "sessionsPerWeek": {
            "type": "integer",
            "minimum": 1,
            "maximum": 21
          },
          "durationMinutes": {
            "type": "integer",
            "minimum": 30,
            "maximum": 240
          },
          "teachingMode": {
            "type": "string",
            "enum": [
              "ONLINE",
              "OFFLINE",
              "HYBRID"
            ]
          },
          "provinceCode": {
            "type": "string"
          },
          "districtCode": {
            "type": "string"
          },
          "locationDetail": {
            "type": "string",
            "maxLength": 500
          },
          "priceVnd": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "schedules": {
            "type": "array",
            "minItems": 1,
            "maxItems": 147,
            "items": {
              "$ref": "#/components/schemas/Schedule"
            }
          }
        },
        "required": [
          "startDate",
          "sessionsPerWeek",
          "durationMinutes",
          "teachingMode",
          "priceVnd",
          "schedules"
        ]
      },
      "CreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "sessionsPerWeek": {
            "type": "integer",
            "minimum": 1,
            "maximum": 21
          },
          "durationMinutes": {
            "type": "integer",
            "minimum": 30,
            "maximum": 240
          },
          "teachingMode": {
            "type": "string",
            "enum": [
              "ONLINE",
              "OFFLINE",
              "HYBRID"
            ]
          },
          "provinceCode": {
            "type": "string"
          },
          "districtCode": {
            "type": "string"
          },
          "locationDetail": {
            "type": "string",
            "maxLength": 500
          },
          "priceVnd": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "schedules": {
            "type": "array",
            "minItems": 1,
            "maxItems": 147,
            "items": {
              "$ref": "#/components/schemas/Schedule"
            }
          },
          "tutorProfileId": {
            "type": "string",
            "format": "uuid"
          },
          "subjectId": {
            "type": "string",
            "format": "uuid"
          },
          "courseId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedListedPriceVnd": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "startDate",
          "sessionsPerWeek",
          "durationMinutes",
          "teachingMode",
          "priceVnd",
          "schedules",
          "tutorProfileId",
          "subjectId",
          "expectedListedPriceVnd"
        ]
      },
      "Action": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expectedVersion": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "expectedVersion"
