NEXT_PUBLIC_API_BASE_URL=http://localhost:5014/api/v1
# Optional same-origin proxy (e.g. Vercel without a shared custom domain): set the backend
# origin here and NEXT_PUBLIC_API_BASE_URL=/api/v1 so auth cookies stay first-party.
# API_PROXY_TARGET=https://tutormatching-api.onrender.com
# Google OAuth "Web application" client ID (public). Must equal Google__ClientId in the backend.
# Leave empty to hide the "Continue with Google" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
