# Copy this file to backend/.env before starting local backend services.
# These values are for local development only. Use a deployment secret store
# outside local development.
POSTGRES_DB=tutormatching
POSTGRES_USER=tutormatching
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5431

# Keep PostgreSQL private to this computer. For controlled LAN/VPN access,
# change this to the host's private IP; never expose port 5432 publicly.
POSTGRES_BIND_ADDRESS=127.0.0.1

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ASP.NET Core reads double underscores as nested configuration keys.
# Keep the port and password synchronized with the PostgreSQL values above.
ConnectionStrings__DefaultConnection="Host=localhost;Port=5431;Database=tutormatching;Username=tutormatching;Password=replace-with-a-local-password"
Frontend__Origin=http://localhost:3000
Cookie__Name=tutormatch_session
Cookie__SecurePolicy=SameAsRequest
Smtp__Host=localhost
Smtp__Port=1025
Smtp__FromAddress=no-reply@tutormatching.local
Smtp__UseTls=false
Smtp__TimeoutSeconds=15

# Controlled development-only Admin seed. Never commit a real password.
SeedAdmin__Enabled=false
SeedAdmin__Email=admin@tutormatching.local
SeedAdmin__FullName=TutorMatching Admin
SeedAdmin__Password=replace-with-a-development-only-password
