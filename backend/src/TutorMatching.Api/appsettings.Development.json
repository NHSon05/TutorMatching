{
  "Frontend": {
    "Origin": "http://localhost:3000"
  },
  "Cookie": {
    "Name": "tutormatch_session",
    "SecurePolicy": "SameAsRequest"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "FromAddress": "no-reply@tutormatching.local",
    "UseTls": false
  },
  "Logging": {
